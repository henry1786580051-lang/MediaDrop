{
  "name": "mediadrop",
  "version": "1.0.6",
  "description": "Self-hosted video and audio downloader",
  "author": "MediaDrop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:frontend && npm run test:cache",
    "test:frontend": "node scripts/test-format-state.js",
    "test:cache": "python3 -B -m unittest discover -s app/tests -v",
    "build:bin": "bash scripts/build-bin.sh",
    "verify:bundle": "node scripts/verify-bundle.js",
    "dist": "electron-builder",
    "dist:mac": "npm run build:bin && electron-builder --mac --arm64 -c.electronDist=node_modules/electron/dist && npm run verify:bundle"
  },
  "build": {
    "publish": null,
    "appId": "com.mediadrop.desktop",
    "productName": "MediaDrop",
    "afterPack": "./scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "MediaDrop",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "!app/downloads/**",
      "!app/config.json",
      "!app/.mediadrop-cache/**",
      "!app/tools/**",
      "!app/tests/**",
      "!downloads",
      "!venv",
      "!*.pyc",
      "!__pycache__"
    ],
    "extraResources": [
      {
        "from": "./app/",
        "to": "app",
        "filter": [
          "**/*",
          "!venv/**",
          "!downloads/**",
          "!config.json",
          "!.mediadrop-cache/**",
          "!tools/**",
          "!tests/**",
          "!.git/**",
          "!__pycache__/**",
          "!app.py",
          "!Dockerfile",
          "!requirements.txt",
          "!start.sh",
          "!mediadrop-server.spec"
        ]
      },
      {
        "from": "./bundled-bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
